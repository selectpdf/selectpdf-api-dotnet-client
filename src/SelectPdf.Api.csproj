<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName></SccProjectName>
    <SccProvider></SccProvider>
    <SccAuxPath></SccAuxPath>
    <SccLocalPath></SccLocalPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net20;net40;netstandard2.0</TargetFrameworks>
    <!-- Per-TFM, NOT a single fixed path. With one shared path the three
         target frameworks compile in parallel into the same file and race:
         the packed net40 xml has shipped truncated mid-element and
         unparseable, which costs net40 consumers their IntelliSense and
         feeds Sandcastle a half-empty api surface. GenerateDocumentationFile
         puts it in $(OutputPath) per framework, where the nuspec and the
         Sandcastle project already look for it. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>SelectPdf</Authors>
    <Product>.NET client for SelectPdf Online REST API</Product>
    <PackageProjectUrl>https://selectpdf.com/html-to-pdf-api/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/selectpdf/selectpdf-api-dotnet-client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>SelectPdf HTML To PDF Online REST API is a professional solution that lets you create PDF from web pages and raw HTML code in your applications. The API is easy to use and the integration takes only a few lines of code. The generated PDFs are perfect. That makes SelectPdf API the best html to pdf online service that can be used.</Description>
    <PackageTags>pdf, html-to-pdf, html-to-pdf-api, pdfa, pdf-ua, accessible-pdf, tagged-pdf, zugferd, factur-x, e-invoicing</PackageTags>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0</AssemblyVersion>
    <FileVersion>1.6.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="mssccprj.scc" />
    <None Remove="SelectPdf.Api.csproj.vspscc" />
    <None Remove="vssver2.scc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <DefineConstants>NET_STANDARD_20</DefineConstants>
  </PropertyGroup>

</Project>
